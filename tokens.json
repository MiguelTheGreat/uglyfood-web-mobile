{
  "$schema": "https://miguelthegreat.github.io/lumina-design-system/tokens.json",
  "name": "Lumina Museum Design Language",
  "version": "1.0.0",
  "origin": ["lumina-art-gallery", "stanza-poetry-gallery"],
  "philosophy": "Quiet archival gallery minimalism. Tactile museum paper, deep charcoal ink, warm metallic bronze accents, exponential deceleration physics, and zero visual clutter.",
  "themes": {
    "light": {
      "label": "Museum Paper",
      "selector": ":root",
      "colors": {
        "--bg-paper": "#f5f2e9",
        "--bg-paper-deep": "#ece6d8",
        "--bg-paper-focus": "#fcfaf4",
        "--ink-primary": "#1a1917",
        "--ink-secondary": "#5c5850",
        "--ink-muted": "rgba(26, 25, 23, 0.38)",
        "--accent-warm": "#a67c52",
        "--accent-warm-light": "#d7b184",
        "--accent-warm-dark": "#7d5b39",
        "--border-subtle": "rgba(26, 25, 23, 0.10)",
        "--border-hairline": "rgba(26, 25, 23, 0.08)",
        "--border-strong": "rgba(26, 25, 23, 0.24)",
        "--surface-glass": "rgba(245, 242, 233, 0.82)",
        "--surface-card": "rgba(255, 253, 248, 0.88)",
        "--surface-card-hover": "#ffffff",
        "--surface-curtain": "#161513"
      }
    },
    "dark": {
      "label": "Gallery Noir",
      "selector": "[data-theme=\"dark\"]",
      "colors": {
        "--bg-paper": "#131210",
        "--bg-paper-deep": "#1a1815",
        "--bg-paper-focus": "#1d1b18",
        "--ink-primary": "#efeae0",
        "--ink-secondary": "#a29a8d",
        "--ink-muted": "rgba(239, 234, 224, 0.36)",
        "--accent-warm": "#c99e6e",
        "--accent-warm-light": "#e2c198",
        "--accent-warm-dark": "#8e6942",
        "--border-subtle": "rgba(239, 234, 224, 0.12)",
        "--border-hairline": "rgba(239, 234, 224, 0.09)",
        "--border-strong": "rgba(239, 234, 224, 0.24)",
        "--surface-glass": "rgba(24, 22, 19, 0.86)",
        "--surface-card": "rgba(28, 26, 22, 0.90)",
        "--surface-card-hover": "rgba(36, 33, 28, 0.96)",
        "--surface-curtain": "#161513"
      }
    }
  },
  "typography": {
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&family=Syncopate:wght@400;700&display=swap",
    "families": {
      "--font-display": {
        "value": "'Syncopate', sans-serif",
        "role": "Brand wordmarks, section kickers, micro-labels, uppercase buttons, indices",
        "tracking": "0.16em to 0.32em",
        "case": "uppercase"
      },
      "--font-serif": {
        "value": "'Cormorant Garamond', Georgia, serif",
        "role": "Editorial headlines, titles, italic epigraphs, pull quotes, literary body",
        "tracking": "-0.01em to 0.04em",
        "case": "sentence or uppercase display"
      },
      "--font-sans": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
        "role": "UI descriptions, forms, technical metadata, code captions",
        "tracking": "0em",
        "case": "sentence"
      }
    }
  },
  "motion": {
    "curves": {
      "--ease-expo": {
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "usage": "Primary museum glide — curtains, reveals, card tilts, button fills"
      },
      "--ease-quart": {
        "value": "cubic-bezier(0.25, 1, 0.5, 1)",
        "usage": "Soft opacity fades and content transitions"
      },
      "--ease-back": {
        "value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
        "usage": "Subtle tactile overshoot for micro-badges and icons"
      },
      "--ease-accordion": {
        "value": "cubic-bezier(0.19, 1, 0.22, 1)",
        "usage": "Exhibition strip flex expansion and 90-degree rotating grid lines"
      }
    }
  },
  "radii": {
    "--radius-sharp": "3px",
    "--radius-slab": "5px",
    "--radius-pill": "999px"
  },
  "shareCardThemes": {
    "etched": { "bg": "#f3efe5", "fg": "#191816", "muted": "#676158", "accent": "#a67c52" },
    "museum": { "bg": "#f5f2e9", "fg": "#1a1917", "muted": "#6b655c", "accent": "#a67c52" },
    "noir": { "bg": "#151412", "fg": "#f5f2e9", "muted": "rgba(245,242,233,0.58)", "accent": "#d8b489" },
    "broadsheet": { "bg": "#faf8f2", "fg": "#181715", "muted": "#726c62", "accent": "#a67c52" },
    "keepsake": { "bg": "#fcfbf8", "fg": "#1a1917", "muted": "#767067", "accent": "#a67c52" }
  }
}
